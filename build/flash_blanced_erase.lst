 209:KTimeSlice/Algorithm/flash_blanced_erase.c **** /* ==================== 记录写入 ==================== */
 210:KTimeSlice/Algorithm/flash_blanced_erase.c **** 
 211:KTimeSlice/Algorithm/flash_blanced_erase.c **** /* 写入一条记录。写序：magic(首) -> crc -> seq -> data_len -> data -> state(末)。
 212:KTimeSlice/Algorithm/flash_blanced_erase.c ****  * magic 最先写，保证撕裂写入不会被误判为空闲槽（避免 1->0 重写问题）；
ARM GAS  C:\Users\Toubidou\AppData\Local\Temp\ccXq3Lba.s 			page 16


 213:KTimeSlice/Algorithm/flash_blanced_erase.c ****  * state 最后写，保证只有完整写入的记录才被标记有效。
 214:KTimeSlice/Algorithm/flash_blanced_erase.c ****  */
 215:KTimeSlice/Algorithm/flash_blanced_erase.c **** static int fbe_write_record(uint32_t addr, uint32_t seq, const uint8_t *data, uint16_t len)
 216:KTimeSlice/Algorithm/flash_blanced_erase.c **** {
 217:KTimeSlice/Algorithm/flash_blanced_erase.c ****     uint16_t i;
 218:KTimeSlice/Algorithm/flash_blanced_erase.c ****     uint16_t crc = fbe_crc_calc((uint8_t)len, data);
 219:KTimeSlice/Algorithm/flash_blanced_erase.c **** 
 220:KTimeSlice/Algorithm/flash_blanced_erase.c ****     if (HAL_FLASH_Unlock() != HAL_OK)
 221:KTimeSlice/Algorithm/flash_blanced_erase.c ****     {
 222:KTimeSlice/Algorithm/flash_blanced_erase.c ****         return -1;
 223:KTimeSlice/Algorithm/flash_blanced_erase.c ****     }
 224:KTimeSlice/Algorithm/flash_blanced_erase.c **** 
 225:KTimeSlice/Algorithm/flash_blanced_erase.c ****     if (fbe_write_halfword(addr + FBE_OFF_MAGIC, FBE_MAGIC) != 0)  goto fail;
 226:KTimeSlice/Algorithm/flash_blanced_erase.c ****     if (fbe_write_halfword(addr + FBE_OFF_CRC, crc) != 0)          goto fail;
 227:KTimeSlice/Algorithm/flash_blanced_erase.c ****     if (fbe_write_word(addr + FBE_OFF_SEQ, seq) != 0)              goto fail;
 228:KTimeSlice/Algorithm/flash_blanced_erase.c ****     if (fbe_write_byte(addr + FBE_OFF_DATA_LEN, (uint8_t)len) != 0) goto fail;
 229:KTimeSlice/Algorithm/flash_blanced_erase.c **** 
 230:KTimeSlice/Algorithm/flash_blanced_erase.c ****     for (i = 0; i < len; i++)
 231:KTimeSlice/Algorithm/flash_blanced_erase.c ****     {
 232:KTimeSlice/Algorithm/flash_blanced_erase.c ****         if (fbe_write_byte(addr + FBE_OFF_DATA + i, data[i]) != 0)
 233:KTimeSlice/Algorithm/flash_blanced_erase.c ****         {
 234:KTimeSlice/Algorithm/flash_blanced_erase.c ****             goto fail;
 235:KTimeSlice/Algorithm/flash_blanced_erase.c ****         }
 236:KTimeSlice/Algorithm/flash_blanced_erase.c ****     }
 237:KTimeSlice/Algorithm/flash_blanced_erase.c **** 
 238:KTimeSlice/Algorithm/flash_blanced_erase.c ****     if (fbe_write_byte(addr + FBE_OFF_STATE, FBE_STATE_VALID) != 0) goto fail;
 239:KTimeSlice/Algorithm/flash_blanced_erase.c **** 
 240:KTimeSlice/Algorithm/flash_blanced_erase.c ****     HAL_FLASH_Lock();
 241:KTimeSlice/Algorithm/flash_blanced_erase.c ****     return 0;
 242:KTimeSlice/Algorithm/flash_blanced_erase.c **** 
 243:KTimeSlice/Algorithm/flash_blanced_erase.c **** fail:
 244:KTimeSlice/Algorithm/flash_blanced_erase.c ****     HAL_FLASH_Lock();
 245:KTimeSlice/Algorithm/flash_blanced_erase.c ****     return -1;
 246:KTimeSlice/Algorithm/flash_blanced_erase.c **** }
